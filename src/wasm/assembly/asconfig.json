{
  "targets": {
    "release": {
      "outFile": "../../../dist/core.wasm",
      "textFile": "../../../dist/core.wat",
      "sourceMap": false,
      "optimizeLevel": 3,
      "shrinkLevel": 1,
      "noAssert": true,
      "enable": ["simd", "threads"],
      "importMemory": true,
      "sharedMemory": true,
      "initialMemory": 256,
      "maximumMemory": 16384
    }
  },
  "options": {
    "runtime": "stub"
  },
  "entries": ["./filter.ts", "./filter-f64.ts", "./aggregate.ts", "./arithmetic.ts", "./compound-filter.ts", "./gather-aggregate.ts"]
}
