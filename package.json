{
  "name": "query-engine",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.config.e2e.js",
    "test:e2e:coverage": "vitest run --config vitest.config.e2e.js --coverage",
    "test:watch": "vitest",
    "start": "node src/cli/index.js",
    "build:wasm": "asc --config src/wasm/assembly/asconfig.json --target release",
    "build": "node scripts/build.js",
    "build:node": "node scripts/build.js --node",
    "build:browser": "node scripts/build.js --browser",
    "serve": "node scripts/serve.js"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.6",
    "assemblyscript": "^0.27.0",
    "buffer": "^6.0.3",
    "esbuild": "^0.25.0",
    "vitest": "^3.2.1"
  },
  "dependencies": {
    "@assemblyscript/loader": "^0.27.0",
    "cli-highlight": "^2.1.11",
    "csv-parser": "^3.2.1"
  }
}
