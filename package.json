{
  "name": "@slexisvn/query-engine",
  "version": "0.1.4",
  "type": "module",
  "main": "./dist/index.node.js",
  "module": "./dist/index.node.js",
  "browser": "./dist/index.browser.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "qe": "./dist/index.cli.js"
  },
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/index.browser.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.node.js",
      "default": "./dist/index.node.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/index.browser.js",
      "default": "./dist/index.browser.js"
    },
    "./cli": "./dist/index.cli.js",
    "./core.wasm": "./dist/core.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.node.js",
    "dist/index.browser.js",
    "dist/index.cli.js",
    "dist/core.wasm",
    "dist/**/*.d.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.js && npm run build:wasm && tsc -p tsconfig.build.json",
    "build:wasm": "asc --config src/wasm/assembly/asconfig.json --target release",
    "test": "npm run build:ts && vitest run",
    "start": "node dist/index.cli.js",
    "test:unit": "npm run build:ts && vitest run --project unit",
    "test:e2e": "npm run build:ts && vitest run --project e2e",
    "build:ts": "tsc -p tsconfig.build.json",
    "viz": "npm --prefix tools/visualizer run dev"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "@vitest/coverage-v8": "^3.2.6",
    "assemblyscript": "^0.27.0",
    "esbuild": "^0.25.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.1"
  },
  "dependencies": {
    "@assemblyscript/loader": "^0.27.0",
    "cli-highlight": "^2.1.11",
    "csv-parser": "^3.2.1"
  }
}
