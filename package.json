{
  "name": "query-engine",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:js": "tsc -p tsconfig.build.json && node scripts/copy-wasm.js",
    "build": "node scripts/build.js",
    "build:wasm": "asc --config src/wasm/assembly/asconfig.json --target release",
    "pretest": "npm run build:js",
    "test": "vitest run",
    "prestart": "npm run build:js",
    "start": "node dist/js/cli/index.js",
    "serve": "node scripts/serve.js"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.6",
    "assemblyscript": "^0.27.0",
    "buffer": "^6.0.3",
    "esbuild": "^0.25.0",
    "typescript": "^6.0.3",
    "vitest": "^3.2.1"
  },
  "dependencies": {
    "@assemblyscript/loader": "^0.27.0",
    "cli-highlight": "^2.1.11",
    "csv-parser": "^3.2.1"
  }
}
